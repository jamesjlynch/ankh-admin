Options -Indexes
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set X-Content-Type-Options "nosniff"
</IfModule>
<FilesMatch "^(lib|view|customer-experience)\.php$">
Require all denied
</FilesMatch>
<FilesMatch "^(?:\.env|config(?:\.php)?|.*\.sqlite(?:-wal|-shm)?|.*\.log)$">
Require all denied
</FilesMatch>
