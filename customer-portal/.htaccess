Options -Indexes
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set X-Content-Type-Options "nosniff"
</IfModule>
<Files "lib.php">
Require all denied
</Files>
<FilesMatch "^(?:\.env|config(?:\.php)?|.*\.sqlite(?:-wal|-shm)?|.*\.log)$">
Require all denied
</FilesMatch>
