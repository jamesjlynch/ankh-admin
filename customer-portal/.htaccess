Options -Indexes
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set X-Content-Type-Options "nosniff"
</IfModule>
<FilesMatch "^(lib|view|customer-experience|account-features|contact-settings|request-watch|request-list-view|request-confirmation|watchlist-view|shop-home|my-fridge|fridge-view|public-catalogue-core|storefront-design|storefront-experience|storefront-card|storefront-commerce|storefront-staff|product-certificates|content-studio)\.php$">
Require all denied
</FilesMatch>
<FilesMatch "^(?:\.env|config(?:\.php)?|.*\.sqlite(?:-wal|-shm)?|.*\.log)$">
Require all denied
</FilesMatch>

<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
<Files "sw.js">
Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>
<FilesMatch "\\.(?:webmanifest|png|svg)$">
Header set X-Content-Type-Options "nosniff"
</FilesMatch>
</IfModule>
